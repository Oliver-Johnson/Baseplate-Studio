# Vendored third-party builds are byte-for-byte upstream artefacts. Git's line-ending
# normalisation would rewrite them on checkout, which changes their bytes and makes the
# checksums recorded in vendor/README.md wrong on a Windows working tree. Leave them be.
vendor/*.js -text

# Generated pages are compared byte-for-byte by build.js --check and test/ci-sim.js.
# Normalising them means the committed bytes and the built bytes can disagree purely
# by platform, which is a confusing way to fail a build that is actually fine.
*.html -text
*.js -text
*.css -text
